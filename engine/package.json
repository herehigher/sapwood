{
  "name": "sapwood",
  "version": "0.3.0-alpha.2",
  "description": "sapwood orchestration engine (conductor, worker, forge, guard, state)",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "main": "dist/index.js",
  "bin": { "sapwood": "dist/cli.js" },
  "files": ["dist", "!dist/**/*.map", "dashboard-dist", "!dashboard-dist/**/*.map", "prompts", "pricing.yaml", "sapwood.config.example.yaml", "THIRD_PARTY_NOTICES"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "biome ci src",
    "build": "tsc",
    "test": "sh scripts/run-tests.sh",
    "test:focus": "node --import tsx --test --test-timeout=60000",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build && node ../scripts/release.ts stamp && node -e \"require('node:fs').copyFileSync('../sapwood.config.example.yaml','sapwood.config.example.yaml')\" && node scripts/stage-dashboard.ts",
    "postpack": "node scripts/stage-dashboard.ts --clean && node -e \"require('node:fs').rmSync('sapwood.config.example.yaml',{force:true})\""
  },
  "repository": { "type": "git", "url": "git+https://github.com/herehigher/sapwood.git" },
  "homepage": "https://github.com/herehigher/sapwood",
  "bugs": { "url": "https://github.com/herehigher/sapwood/issues" },
  "keywords": ["claude-code", "automation", "github", "governance", "ci"],
  "author": { "name": "HereHigher", "url": "https://x.com/kanhigher" },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "dependencies": {
    "yaml": "2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
