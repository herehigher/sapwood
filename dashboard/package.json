{
  "name": "@sapwood/dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "sapwood v0.2 dashboard — read-only view of the loop (issue #17)",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node --import tsx src/demo/export-cli.ts && vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "build": "node --import tsx src/demo/export-cli.ts && vite build && node build-server.mjs",
    "test": "node --import tsx --test --test-timeout=60000 \"*.test.ts\" \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "contrast": "node --import tsx src/contrast.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "animejs": "^4.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/node": "^22.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.5"
  }
}
