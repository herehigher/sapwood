{
  "name": "sapwood-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "sapwood — the autonomous coding loop with governance built in",
  "type": "module",
  "workspaces": [
    "engine",
    "dashboard"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "npm run -ws typecheck && tsc -p scripts",
    "lint": "biome ci .",
    "test": "npm run -ws test && node --test scripts/*.test.ts",
    "build": "npm run -ws build",
    "release": "node scripts/release.ts",
    "check-links": "node scripts/check-links.ts --internal-only"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.3"
  }
}
