// Type-checks the root scripts/*.ts files. They ship with no build step — Node 24
// runs them directly off disk, stripping types at runtime without checking them —
// so this config, not `tsconfig.base.json`'s NodeNext build
// setup, has to describe what Node's type-stripping actually executes: relative
// imports keep their literal `.ts` extension (e.g. release.test.ts importing
// "./release.ts"), which only resolves under `moduleResolution: bundler` +
// `allowImportingTsExtensions` — the same pairing dashboard/tsconfig.json already
// uses for the same reason. noEmit because these scripts are never compiled to
// dist/; there is nothing here to build.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["*.ts"]
}
