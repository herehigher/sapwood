+      if (gitConfigValueDefinesAlias(tokens[i + 1]!)) return true;
+    } else if (tok.startsWith("-c") && tok.length > 2 && tok[2] !== "=") {
+      if (gitConfigValueDefinesAlias(tok.slice(2))) return true;
