+  // NEVER compared against defaultBranch (#679 gate② P2(d): a remote literally named "main" is
+  // legitimate and must not be over-blocked) — UNLESS `--repo`/`--repo=` already supplied the
+  // repository (#679 gate② round 2 P1), in which case there IS no positional remote to skip and
+  // every positional is a candidate refspec. Every remaining positional (or, for `--delete`, a
+  // candidate delete target — the same bare-name check below already covers that form, so
+  // `--delete` needs no separate branch) is scanned.
+  const refspecs = repoFromFlag ? positional : positional.slice(1);
