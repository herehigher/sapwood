+// docs/security.md's #679 section and the KNOWN RESIDUAL row in guard.test.ts below.
+const GIT_GLOBAL_VALUE_FLAGS = new Set(["-C", "--git-dir", "--work-tree", "--namespace", "-c", "--exec-path"]);
