+// ── #731: sapwood pause/stop/estop CLI verbs — same control-sentinel boundary as the check
+// above, reached through the CLI verb instead of a literal path argument ───────────────────
+// #731 added first-class `sapwood pause`/`stop`/`estop` verbs (each with a `clear` form) that
+// create/remove the exact same three files CONTROL_SENTINEL_RE protects above — but they
+// resolve `dirname(dbPath)` + a fixed filename INTERNALLY, so no sentinel path is ever a
+// literal command-line argument for checkControlSentinelArg to catch. #779/#809 just closed
+// the raw-touch/rm class (a worker deleting/forging a control sentinel directly); #731 shipped,
+// in the SAME PR that introduced the verbs, an equally first-class, operator-documented, easy-
+// to-run bypass of that closure — `sapwood estop clear` lifts an already-fired EMERGENCY_STOP
+// with no sentinel path in sight. This closes that gap the same way checkControlSentinelArg
+// closes the "node script.js <sentinel-path>" indirection above: judge the COMMAND, not a path
+// argument.
+//
+// Scope, deliberately minimal (大道至简): ONLY the three stop-control verbs (activate AND
+// `clear` forms; nothing here inspects flags — only the verb token immediately following the
+// entrypoint, so flag order/position never matters). `park`/`run`/`status`/`events` are
+// read/reconcile paths a worker has ordinary legitimate reason to invoke and stay OUT of scope
+// — widening this rule to every subcommand is an explicit non-goal (#731 PR discussion), not an
+// oversight.
+const STOP_CONTROL_VERBS = new Set(["pause", "stop", "estop"]);
+
+/** True when `tok`'s basename is the sapwood CLI entrypoint: the linked `sapwood` binary, or
+ *  running it from source/dist (`node .../cli.js` / `node .../cli.ts` — the exact invocation
+ *  this repo's own `commands/sapwood-status.md` and `docs/getting-started.md` Channel A
+ *  instructions use). Matched on basename only, same convention `scanGhOverreach`/`checkOpaque`
+ *  already use to resolve a path-prefixed command word — deliberately NOT scoped to a specific
+ *  directory prefix (`engine/dist/`, `engine/src/`), so a clone checked out anywhere still
+ *  matches; the tradeoff (an unrelated project's own same-named `cli.js`/`cli.ts` would also
+ *  match) is the same coarse-but-safe posture `checkControlSentinelArg` already accepts for an
+ *  arbitrary node-script indirection above. */
+function isSapwoodCliEntrypoint(tok: string): boolean {
+  const base = basename(tok).toLowerCase();
+  return base === "sapwood" || base === "cli.js" || base === "cli.ts";
+}
+
+/**
+ * `tokens` is a full command's token list, scanned at ANY position (same wrapper-tolerance
+ * stance `checkControlSentinelArg`/`checkBashWritePath` already take — a wrapper can't hide the
+ * invocation). Returns a BLOCK reason the first time a sapwood-CLI-entrypoint token is
+ * IMMEDIATELY followed by one of the three stop-control verbs, else null. "Immediately
+ * followed" mirrors the real CLI's own contract (`cli.ts`'s `runCli`: `argv[2]` — the token
+ * right after the entrypoint — IS the subcommand); a flag interposed between them would not
+ * actually invoke the verb either, so this fence needs no flag-skipping to stay accurate, and
+ * every flag/positional AFTER the verb (`--confirm`, `clear`, `--config PATH`, in any order) is
+ * irrelevant to the match — only the verb token itself is.
+ */
+function checkStopControlVerb(tokens: string[]): string | null {
+  for (let i = 0; i < tokens.length - 1; i++) {
+    if (!isSapwoodCliEntrypoint(tokens[i]!)) continue;
+    const verb = tokens[i + 1]!;
+    if (STOP_CONTROL_VERBS.has(verb)) {
+      return (
+        `BLOCK [stop-control] sapwood ${verb} is a control-sentinel CLI verb (same boundary as ` +
+        `data/PAUSE, data/KILL_SWITCH, data/EMERGENCY_STOP) — human-merge-only, see docs/security.md`
+      );
+    }
+  }
+  return null;
+}
