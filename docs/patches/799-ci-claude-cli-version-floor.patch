# Pending human-applied patch — issue #799
#
# WHAT: adds a new CI job, `claude-cli-floor`, that installs the EXACT floor version of the
#       Claude Code CLI this engine declares (`engine/src/roles/worker.ts`'s
#       `MIN_CLAUDE_CLI_VERSION`, currently 2.1.209), runs `claude --help` (no authentication,
#       no API call, no spend), and asserts every long flag the engine's worker/probe argv
#       depends on is present in that help output — via the new
#       `engine/scripts/check-claude-cli-flags.ts` this same PR ships (a normal, producer-ok
#       engine file; only the workflow step below is the human-merge-only half). A future engine
#       change that starts depending on a flag the pinned floor's CLI does not support now fails
#       CI instead of failing every operator's first run with a misread-as-outage
#       `error: unknown option ...`.
#
# WHY IT MATTERS: this is the second, CI-ENFORCEMENT half of docs/PLAN.md:129 — "state a minimum
#       Claude Code CLI version and test against it in CI." #799's engine-side half (the declared
#       floor constant, the drift test tying it to the docs, and the once-per-start WARN-only
#       startup check) ships in this PR's ordinary commits; this half is the "test against it in
#       CI" clause, which needs a `.github/workflows/**` change and so cannot land the same way.
#
# WHY IT IS A PATCH AND NOT A COMMIT: `.github/workflows/**` is human-merge-only
#       (docs/security.md "Human-merge-only paths"), enforced by the guard, not by convention.
#       An autonomous worker's write there is denied at the tool level. The guard constrains
#       Claude tool calls, never a human's editor.
#
# APPLY (from the repo root), then delete this file:
#       git apply docs/patches/799-ci-claude-cli-version-floor.patch
#       git rm docs/patches/799-ci-claude-cli-version-floor.patch
#
# NOTE ON COST: `npm i -g @anthropic-ai/claude-code@2.1.209` downloads a real package from the
#       npm registry on every CI run — a few seconds, not billable Anthropic spend (the job never
#       authenticates or calls `-p`). If the floor version is ever superseded, update
#       `MIN_CLAUDE_CLI_VERSION` (worker.ts), docs/getting-started.md, and docs/configuration.md
#       TOGETHER (claude-version-startup-check.test.ts's drift test enforces the docs pair; this
#       workflow's own pin is the one place outside that test's reach — update it by hand when
#       the floor moves) — or regenerate this patch against the new value.
#
# NOTE ON NECESSITY: `docs/patches/` currently holds several patches issue #789 reports as
#       unapplied; this adds one more to that pile unless applied promptly. That is a consequence
#       of the human-merge-only boundary, not a reason to skip this half.
#
# Generated against .github/workflows/ci.yml at blob a2becd17b8b021668dd613a8e2c51779e9740822.
# If the file has since moved, the hunk still locates by context (offset-tolerant); re-check the
# result.

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -68,6 +68,30 @@ jobs:
       - run: timeout --kill-after=30s 600 npm --workspace engine test
       - run: timeout --kill-after=30s 300 npm --workspace dashboard test
 
+  # #799 (PLAN.md:129's CI-enforcement half — engine-side half shipped in ordinary commits, this
+  # job is the human-applied remainder docs/patches/799-ci-claude-cli-version-floor.patch adds):
+  # installs the EXACT floor CLI version and asserts its --help output offers every long flag
+  # the engine's worker/probe argv depends on — zero spend, no auth, no -p. A future engine
+  # change that starts depending on a flag the pinned floor doesn't support fails HERE instead
+  # of failing silently for every operator still on the floor version.
+  claude-cli-floor:
+    runs-on: [self-hosted, mac-mini-docker-runner] # pre-public; see the `test` job's own note above
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
+        with:
+          node-version: 24
+          cache: npm
+          cache-dependency-path: package-lock.json
+      - run: npm ci
+      - name: Install the floor Claude Code CLI version (no auth, no spend — package install only)
+        run: npm i -g @anthropic-ai/claude-code@2.1.209
+      - name: Assert claude --help offers every long flag the engine's argv depends on
+        run: npx tsx engine/scripts/check-claude-cli-flags.ts
+
